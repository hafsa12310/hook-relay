# /api uses the Vite development proxy to localhost:3000.
# Production requires a same-origin reverse proxy or an API with configured CORS.
VITE_API_BASE_URL=/api
# If another app occupies port 3000, run the NestJS API with PORT=3001
# and set this target to http://localhost:3001. Restart Vite after changing it.
HOOKRELAY_API_PROXY_TARGET=http://localhost:3000
